source .venv/bin/activate
export DEVICE=mps
export DYLD_LIBRARY_PATH="$(find .venv -type d -path '*/torch/lib' 2>/dev/null)"
export LIBTORCH_USE_PYTORCH=1

# export BOARD=19
# export CONV_FILTER=256
# export GAME_WINDOW=500000
# export KOMI=6.5
# export MCTS_SIM=1600
# export RES_BLOCK=20
export BATCH=$((1 << 11))
export BOARD=9
export CONV_FILTER=64
export C_PUCT=1.5
export EVAL_GAME=400
export EVAL_RATE=0.55
export GAME_THREAD=$(($(python3 -c "import os; print(os.cpu_count())") << 4))
export HISTORY=8
export INITIAL_LR=0.01
export KOMI=7
export L2_REGULARIZATION=0.0001
export LR_MILESTONES="[10000, 15000, 17500]"
export MCTS_BATCH=8
export MCTS_SIM=256
export GAME_WINDOW=40000
export RESIGN=0.95
export RES_BLOCK=10
